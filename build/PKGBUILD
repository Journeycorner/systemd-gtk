# Maintainer: Florian Reisecker <florian[dot]reisecker[at]gmail[dot]com>

pkgname=systemd-gtk
pkgver=0.1.1
pkgrel=1
arch=('x86_64')
pkgdesc="System and user unit manager built with Relm4 and libadwaita"
url="https://github.com/Journeycorner/systemd-gtk"
license=('0BSD')
depends=('gtk4>=4.22' 'libadwaita>=1.9' 'glib2>=2.88' 'systemd' 'dbus')
makedepends=('rustup' 'desktop-file-utils')
optdepends=('polkit: authorization for system unit changes; a desktop authentication agent is also required')
# scripts/package-arch.sh snapshots the current checkout beside this recipe.
# The archive deliberately includes uncommitted source changes.
source=('systemd-gtk.tar.gz')
sha256sums=('SKIP')

prepare() {
  export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-$srcdir/target}"
  cd "$srcdir"
  cargo fetch --locked
}

build() {
  # makepkg exports RUSTFLAGS, which would otherwise shadow repository config.
  export RUSTFLAGS="${RUSTFLAGS:-} -C target-cpu=native"
  export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-$srcdir/target}"
  cd "$srcdir"
  cargo build --frozen --release
}

check() {
  export RUSTFLAGS="${RUSTFLAGS:-} -C target-cpu=native"
  export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-$srcdir/target}"
  cd "$srcdir"
  cargo test --frozen
  desktop-file-validate data/systemd-gtk.desktop
}

package() {
  cd "$srcdir"
  install -D -m755 "${CARGO_TARGET_DIR:-$srcdir/target}/release/systemd-gtk" "$pkgdir/usr/bin/systemd-gtk"
  install -D -m644 data/app-icon.png "$pkgdir/usr/share/icons/hicolor/512x512/apps/com.journeycorner.systemd-gtk.png"
  install -D -m644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -D -m644 data/systemd-gtk.desktop "$pkgdir/usr/share/applications/com.journeycorner.systemd-gtk.desktop"
}
